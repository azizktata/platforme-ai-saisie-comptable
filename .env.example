APP_NAME=ComptaFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tunis
APP_LOCALE=fr
VITE_DEV_SERVER_ORIGIN=http://127.0.0.1:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comptaflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=300
FILESYSTEM_DISK=local

# Local-development cabinet created by DatabaseSeeder only in local/testing.
# Do not reuse demo credentials outside a private development environment.
DEMO_CABINET_NAME="Cabinet de démonstration"
DEMO_USER_EMAIL=demo@example.test
DEMO_USER_PASSWORD=password

# OCR is queued on the database connection; run a worker for the ocr queue.
# OCR.space Free is the default provider; its API key stays on the server.
OCR_PROVIDER=ocr_space
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_ENGINE=3
OCR_SPACE_TIMEOUT=180
# Optional absolute path to a PEM CA bundle (also falls back to MISTRAL_CA_BUNDLE).
OCR_SPACE_CA_BUNDLE=

# Keep Mistral configured for a future OCR_PROVIDER=mistral switch.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_TIMEOUT=180
# Optional absolute path to a PEM CA bundle.
# Keep TLS verification enabled; do not set this to false.
MISTRAL_CA_BUNDLE=

# OpenRouter powers OCR text structuring (OCR.space) and accounting proposals.
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# Accounting proposals use the free router; invoice extraction uses a free model with reasoning disabled.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EXTRACTION_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_EXTRACTION_MAX_TOKENS=2500
OPENROUTER_TIMEOUT=120
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ComptaFlow
OPENROUTER_MAX_OCR_CHARS=100000
# Optional absolute path to a PEM CA bundle; TLS verification stays enabled.
OPENROUTER_CA_BUNDLE=
