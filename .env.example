APP_NAME=ComptaFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tunis
APP_LOCALE=fr
VITE_DEV_SERVER_ORIGIN=http://127.0.0.1:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comptaflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=300
FILESYSTEM_DISK=local

# Local-development cabinet created by DatabaseSeeder only in local/testing.
# Do not reuse demo credentials outside a private development environment.
DEMO_CABINET_NAME="Cabinet de démonstration"
DEMO_USER_EMAIL=demo@example.test
DEMO_USER_PASSWORD=password

# OCR is queued on the database connection; run a worker for the ocr queue.
# Configure a server-side Mistral API key to enable invoice extraction.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_TIMEOUT=180
# Optional absolute path to a PEM CA bundle if PHP cannot find the system trust store.
# Keep TLS verification enabled; do not set this to false.
MISTRAL_CA_BUNDLE=
