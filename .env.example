APP_NAME=ComptaFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tunis
APP_LOCALE=fr
VITE_DEV_SERVER_ORIGIN=http://127.0.0.1:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comptaflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Local-development cabinet created by DatabaseSeeder only in local/testing.
# Do not reuse demo credentials outside a private development environment.
DEMO_CABINET_NAME="Cabinet de démonstration"
DEMO_USER_EMAIL=demo@example.test
DEMO_USER_PASSWORD=password

# Add Mistral credentials when the OCR/analysis phases are implemented.
MISTRAL_API_KEY=
